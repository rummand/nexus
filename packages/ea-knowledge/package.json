{
  "name": "@nexus/ea-knowledge",
  "version": "0.1.0",
  "private": true,
  "description": "A standalone enterprise-architecture knowledge base: an openly-licensed corpus, lexical retrieval with citations, and the doctrine agents are grounded in.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./corpus": "./src/corpus.ts",
    "./ingest": "./src/ingest.ts"
  },
  "bin": {
    "ea-kb": "./src/cli.ts"
  },
  "scripts": {
    "ingest": "NODE_USE_ENV_PROXY=1 tsx src/cli.ts ingest",
    "ask": "NODE_USE_ENV_PROXY=1 tsx src/cli.ts ask",
    "stats": "tsx src/cli.ts stats",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "@types/node": "^22.19.4"
  }
}
