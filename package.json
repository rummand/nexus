{
  "name": "nexus",
  "private": true,
  "version": "0.1.0",
  "description": "Nexus \u2014 AI-native enterprise architecture canvas",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @nexus/web dev",
    "build": "pnpm --filter @nexus/web build",
    "start": "pnpm --filter @nexus/web start",
    "lint": "pnpm --filter @nexus/web lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @nexus/web db:generate",
    "db:seed": "pnpm --filter @nexus/web db:seed",
    "db:reset": "pnpm --filter @nexus/web db:reset",
    "e2e": "pnpm --filter @nexus/web e2e",
    "kb:ingest": "pnpm --filter @nexus/ea-knowledge ingest",
    "kb:ask": "pnpm --filter @nexus/ea-knowledge ask",
    "docs:capture": "pnpm --filter @nexus/web docs:capture"
  }
}
