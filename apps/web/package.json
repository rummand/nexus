{
  "name": "@nexus/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "node scripts/reset-db.mjs",
    "e2e": "node e2e/run.mjs",
    "e2e:attach": "BASE_URL=${BASE_URL:-http://localhost:3000} node e2e/smoke.mjs",
    "db:pg:schema": "node scripts/generate-pg-schema.mjs",
    "db:pg:generate": "node scripts/generate-pg-schema.mjs && drizzle-kit generate --config drizzle.pg.config.ts",
    "docs:capture": "node scripts/capture-docs.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@nexus/ea-knowledge": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.41.0",
    "nanoid": "^5.1.5",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "playwright": "1.56.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
